# Maintainer: Daaboulex <https://github.com/Daaboulex>

pkgname=vkdaedalus-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Vulkan post-processing layer with an in-game overlay, on Wayland and X11"
arch=('x86_64')
url="https://github.com/Daaboulex/vkDaedalus"
license=('zlib')
depends=('gcc-libs' 'libx11' 'libxi' 'wayland' 'libxkbcommon' 'vulkan-icd-loader')
makedepends=('git' 'glslang' 'meson' 'ninja' 'pkgconf' 'spirv-headers' 'vulkan-headers' 'wayland-protocols')
provides=('vkdaedalus')
conflicts=('vkbasalt-overlay-wayland-git')
replaces=('vkbasalt-overlay-wayland-git')
source=("$pkgname::git+https://github.com/Daaboulex/vkDaedalus.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"
  arch-meson build --buildtype=release
  ninja -C build
}

check() {
  cd "$srcdir/$pkgname"
  meson test -C build --print-errorlogs
}

package() {
  cd "$srcdir/$pkgname"
  DESTDIR="$pkgdir" ninja -C build install

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 SHADER-COMPATIBILITY.md "$pkgdir/usr/share/doc/$pkgname/SHADER-COMPATIBILITY.md"
}
