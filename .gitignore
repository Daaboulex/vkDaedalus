# Canonical .gitignore — Nix Packaging Standard.
# Bootstrapped into each repo by sync.sh. A repo may append its own entries
# below a "# repo-specific" marker; the entries above are the fleet baseline.

# Build outputs
result
result-*

# Nix / direnv
.direnv/

# git-hooks.nix generated config (a /nix/store symlink — never commit)
.pre-commit-config.yaml

# AI agent artifacts -- never tracked (the no-tracked-ignored-files CI check fails if any are committed)
CLAUDE.md
GEMINI.md
AGENTS.md
AI-progress.json
AI-tasks.json
.session-handoff*.md
.claude/
.gemini/
.codex/
.cursor/
.superpowers/
.ai-context/
.planning/

# Caches
__pycache__/
.pytest_cache/
.ruff_cache/
.rumdl_cache/
.mypy_cache/

# repo-specific — this repo is also the C++/meson source tree.
# (flake.lock is intentionally NOT ignored: a flake's lock must be committed.)
*.spv
*.old
*.so
*.o
build*/
imgui.ini
.cache/
.devshell/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage/
build/
dist/
target/
*.egg-info/
.eggs/
node_modules/
.venv/
venv/
/htmlcov/
/coverage/
/build/
/dist/
/target/
/subprojects/*
!/subprojects/*.wrap
!/subprojects/packagefiles/
